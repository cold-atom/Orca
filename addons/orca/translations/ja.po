msgid "\n\nLocal request estimate: %d tokens (%s).\nSafe input budget: %d of %d tokens.\nReserved output: %d; future tool result: %d.\nIncludes request instructions, tool schemas/results, image reserves and private continuation when applicable. This estimate is separate from provider-reported usage and billing reservations."
msgstr "\n\nローカルのリクエスト推定：%d トークン（%s）。\n安全な入力予算：%d / %d トークン。\n出力の予約：%d、後続のツール結果：%d。\nリクエストの指示、ツールのスキーマと結果、画像用の予約、該当する場合は非公開の継続情報を含みます。この推定は、プロバイダー報告の使用量や課金用の予約とは別です。"

msgid "Sign in to use Orca-hosted models."
msgstr "Orca のホストモデルを利用するにはログインしてください。"

msgid "Secure credential storage is unavailable. Enable your OS credential vault."
msgstr "安全な資格情報ストレージを利用できません。OS の資格情報ストアを有効にしてください。"

msgid "Orca Cloud could not start sign-in. Check your connection and try again."
msgstr "Orca Cloud へのログインを開始できませんでした。接続を確認して再試行してください。"

msgid "Sign in or sign up in your browser, then approve this editor."
msgstr "ブラウザーでログインまたは新規登録し、このエディターを承認してください。"

msgid "The account service returned invalid credentials. Start sign-in again."
msgstr "アカウントサービスが無効な資格情報を返しました。ログインをやり直してください。"

msgid "The OS credential vault could not be opened. Unlock it and sign in again."
msgstr "OS の資格情報ストアを開けませんでした。ロックを解除して再度ログインしてください。"

msgid "Your connection could not be saved securely. Unlock the OS vault and try again."
msgstr "接続情報を安全に保存できませんでした。OS の資格情報ストアのロックを解除して再試行してください。"

msgid "Sign-in was declined or interrupted. Start a new connection."
msgstr "ログインが拒否または中断されました。接続をやり直してください。"

msgid "The pairing code expired. Sign in again to get a new code."
msgstr "ペアリングコードの有効期限が切れました。再度ログインして新しいコードを取得してください。"

msgid "Sign-in cancelled."
msgstr "ログインをキャンセルしました。"

msgid "Refresh your account connection before the next request."
msgstr "次のリクエストの前にアカウントの接続を更新してください。"

msgid "Account information could not be refreshed. Reconnect if your session was revoked."
msgstr "アカウント情報を更新できませんでした。セッションが取り消されている場合は再接続してください。"

msgid "The account service returned invalid account information."
msgstr "アカウントサービスが無効なアカウント情報を返しました。"

msgid "Your account is connected. Hosted models are ready to use."
msgstr "アカウントは接続済みです。ホストモデルを利用できます。"

msgid "Signing out…"
msgstr "ログアウト中…"

msgid "Signed out locally. Check Orca Console to revoke the editor session if the backend or OS vault was unavailable."
msgstr "ローカルでログアウトしました。バックエンドや OS の資格情報ストアを利用できなかった場合は、Orca Console でエディターのセッションを取り消してください。"

msgid "The backend is offline. Your saved connection is retained; use Refresh account when it is available."
msgstr "バックエンドはオフラインです。保存済みの接続情報は保持されます。利用可能になったらアカウントを更新してください。"

msgid "Your saved connection could not be restored. Check the backend and OS vault, then sign in again if needed."
msgstr "保存済みの接続を復元できませんでした。バックエンドと OS の資格情報ストアを確認し、必要に応じて再度ログインしてください。"

msgid "Updates come from official Orca GitHub Releases."
msgstr "更新は Orca の公式 GitHub Releases から取得します。"

msgid "Orca %s is available."
msgstr "Orca %s が利用可能です。"

msgid "Downloading Orca %s…"
msgstr "Orca %s をダウンロード中…"

msgid "Update installed. Your previous addon is retained for rollback."
msgstr "更新をインストールしました。前のアドオンは復元用に保持されています。"

msgid "The previous addon was restored."
msgstr "前のアドオンを復元しました。"

msgid "The previous update stopped."
msgstr "前の更新は停止しました。"

msgid "Checking GitHub Releases…"
msgstr "GitHub Releases を確認中…"

msgid "Could not check for updates."
msgstr "更新を確認できませんでした。"

msgid "Unsupported release metadata."
msgstr "未対応のリリースメタデータです。"

msgid "Checking installed addon files…"
msgstr "インストール済みアドオンのファイルを確認中…"

msgid "Verifying and staging the release…"
msgstr "リリースを検証して準備中…"

msgid "Verified. Preparing the editor restart…"
msgstr "検証済み。エディターの再起動を準備中…"

msgid "Closing Godot; the verified updater will reopen this project."
msgstr "Godot を終了します。検証済みの更新ツールがこのプロジェクトを再度開きます。"

msgid "GDScript is valid."
msgstr "GDScript は有効です。"

msgid "No GDScript validation required."
msgstr "GDScript の検証は不要です。"

msgid "Parsed and verified project.godot Input Map state."
msgstr "project.godot の入力マップを解析・検証しました。"

msgid "Loaded the saved target as a PackedScene and verified project.godot."
msgstr "保存済みの対象を PackedScene として読み込み、project.godot を検証しました。"

msgid "Validated allowlisted typed settings and parsed the candidate project.godot."
msgstr "許可された型付き設定を検証し、候補の project.godot を解析しました。"

msgid "Packed, saved, and reloaded the complete proposed scene as a PackedScene."
msgstr "提案されたシーン全体を PackedScene としてパック・保存し、再読み込みしました。"

msgid "Trusted script loaded; packed, saved, and reloaded the complete proposed scene."
msgstr "信頼済みのスクリプトを読み込み、提案されたシーン全体をパック・保存・再読み込みしました。"

msgid "Hash-bound intent validated without loading the scene or compiling the script. Approval may execute script initialization while constructing and revalidating the candidate."
msgstr "シーンの読み込みやスクリプトのコンパイルを行わず、ハッシュに結び付いた意図を検証しました。承認後、候補の構築と再検証時にスクリプトの初期化が実行される場合があります。"

