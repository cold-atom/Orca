msgstr ""
"Language: ko\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "If Orca has been useful to you, a GitHub star or an honest Godot Asset Library review would help other Godot developers discover the project. Thanks for supporting Orca!"
msgstr "Orca가 도움이 되었다면 GitHub에 별을 남기거나 Godot 에셋 라이브러리에 솔직한 리뷰를 작성해 주세요. 다른 Godot 개발자들이 이 프로젝트를 발견하는 데 도움이 됩니다. Orca를 응원해 주셔서 감사합니다!"

msgid "Star on GitHub"
msgstr "GitHub에 별 남기기"

msgid "Resume remaining work"
msgstr "남은 작업 계속하기"

msgid "Apply in editor"
msgstr "편집기에 적용"

msgid "Validated the live native transform and saved instance provenance without loading scenes or scripts."
msgstr "씬이나 스크립트를 로드하지 않고 현재 네이티브 변환과 저장된 인스턴스의 원본 정보를 검증했습니다."

msgid "\nBaseline  Current editor state, including unsaved edits. Earlier edits are preserved; consecutive transforms do not require saving."
msgstr "\n기준  저장하지 않은 편집을 포함한 현재 에디터 상태입니다. 기존 편집은 유지되며 연속 변환 사이에 저장할 필요가 없습니다."

msgid "Revert rechecks the reviewed editor state and Undo history."
msgstr "되돌리기 전에 검토한 에디터 상태와 실행 취소 기록을 다시 확인합니다."

msgid "Revert in editor"
msgstr "편집기에서 되돌리기"

msgid "APPLIED IN EDITOR · SAVE PENDING"
msgstr "편집기에 적용됨 · 저장 대기"

msgid "SAVED · NOT VERIFIED"
msgstr "저장됨 · 미검증"

msgid "SAVE OBSERVED · NOT VERIFIED"
msgstr "저장 관찰됨 · 미검증"

msgid "UNDONE IN EDITOR"
msgstr "편집기에서 실행 취소됨"

msgid "REVERTED IN EDITOR · SAVE PENDING"
msgstr "편집기에서 되돌림 · 저장 대기"

msgid "EDITOR STATE CHANGED"
msgstr "편집기 상태 변경됨"

msgid "\n\nKeeps the scene open and preserves normal Godot Undo. Applies in the editor only; save the scene before running it. Script trust also covers live attachment, property restoration and revalidation."
msgstr "\n\n씬을 열린 상태로 유지하며 Godot의 일반 실행 취소 기록을 보존합니다. 편집기에만 적용되므로 실행하기 전에 씬을 저장하세요. 스크립트 신뢰 승인에는 편집기 내 연결, 속성 복원 및 재검증도 포함됩니다."

msgid "Continue the unfinished tasks in the current checklist. Re-inspect the current project state before acting. Do not repeat completed actions. Reassess blocked tasks and use the current mode and normal edit permissions."
msgstr "현재 체크리스트의 미완료 작업을 계속하세요. 작업 전에 프로젝트의 현재 상태를 다시 확인하고 완료된 작업은 반복하지 마세요. 막힌 작업을 다시 평가하고 현재 모드와 일반 편집 권한을 따르세요."

msgid "Finding Orca useful?"
msgstr "Orca가 도움이 되었나요?"

msgid "A GitHub star or an honest Godot Asset Library review helps other Godot developers discover the project. Thanks for supporting Orca!"
msgstr "GitHub에 별을 남기거나 Godot 에셋 라이브러리에 솔직한 리뷰를 작성하면 다른 Godot 개발자들이 이 프로젝트를 발견하는 데 도움이 됩니다. Orca를 응원해 주셔서 감사합니다!"

msgid "Dismiss support reminder"
msgstr "응원 안내 닫기"

msgid "Leave a review"
msgstr "리뷰 작성"

msgid "Not now"
msgstr "나중에"

msgid "Don't ask again"
msgstr "다시 묻지 않기"

msgid "Open Orca's GitHub repository in your browser"
msgstr "브라우저에서 Orca의 GitHub 저장소 열기"

msgid "Open Orca's Godot Asset Library page in your browser"
msgstr "브라우저에서 Orca의 Godot 에셋 라이브러리 페이지 열기"

msgid "Settings"
msgstr "설정"

msgid "Language"
msgstr "언어"

msgid "Done"
msgstr "완료"

msgid "GENERAL SETTINGS"
msgstr "일반 설정"

msgid "Changes Orca's interface only. Replies follow your message language, using this language when unclear."
msgstr "Orca의 인터페이스만 변경합니다. 답변은 메시지의 언어를 따르며, 언어가 불분명하면 이 언어를 사용합니다."

msgid "Provider"
msgstr "제공업체"

msgid "System"
msgstr "시스템"

msgid "Account"
msgstr "계정"

msgid "About"
msgstr "Orca 정보"

msgid "API CONFIGURATION"
msgstr "API 설정"

msgid "API Provider"
msgstr "API 제공업체"

msgid "API Key"
msgstr "API 키"

msgid "Optional API Key"
msgstr "API 키(선택 사항)"

msgid "Enter API key"
msgstr "API 키 입력"

msgid "Optional for local servers"
msgstr "로컬 서버에서는 선택 사항"

msgid "Show"
msgstr "표시"

msgid "Hide"
msgstr "숨기기"

msgid "Get an API key"
msgstr "API 키 받기"

msgid "Stored in Godot Editor Settings and used only for requests to the selected provider."
msgstr "Godot 에디터 설정에 저장되며, 선택한 제공업체에 보내는 요청에만 사용됩니다."

msgid "Base URL"
msgstr "기본 URL"

msgid "Responses (reasoning + tools)"
msgstr "Responses(추론 + 도구)"

msgid "Reasoning Continuation"
msgstr "추론 이어가기"

msgid "Standard"
msgstr "표준"

msgid "DeepSeek reasoning"
msgstr "DeepSeek 추론"

msgid "For Azure DeepSeek deployments, preserve private reasoning through Chat or Responses tool follow-ups and remove one leaked leading </think> delimiter. Works with custom deployment names."
msgstr "Azure DeepSeek 배포에서는 Chat 또는 Responses의 후속 도구 요청에서도 비공개 추론을 유지하고, 앞부분에 노출된 </think> 구분자 하나를 제거합니다. 사용자 지정 배포 이름도 지원합니다."

msgid "Model"
msgstr "모델"

msgid "Search available models..."
msgstr "사용 가능한 모델 검색…"

msgid "Refresh"
msgstr "새로고침"

msgid "Model ID"
msgstr "모델 ID"

msgid "Exact deployment name"
msgstr "정확한 배포 이름"

msgid "Enable unconfirmed image input"
msgstr "미확인 이미지 입력 활성화"

msgid "Use only if this exact endpoint and model accept image_url content. This does not enable Agent tools or verify vision quality."
msgstr "이 엔드포인트와 모델이 image_url 콘텐츠를 지원하는 경우에만 사용하세요. 에이전트 도구를 활성화하거나 이미지 인식 품질을 검증하지는 않습니다."

msgid "Reasoning Effort"
msgstr "추론 수준"

msgid "Provider default"
msgstr "제공업체 기본값"

msgid "None"
msgstr "없음"

msgid "Minimal"
msgstr "최소"

msgid "Low"
msgstr "낮음"

msgid "Medium"
msgstr "중간"

msgid "High"
msgstr "높음"

msgid "Xhigh"
msgstr "매우 높음"

msgid "Max"
msgstr "최대"

msgid "Higher effort can improve difficult planning and debugging, but may use more tokens."
msgstr "추론 수준을 높이면 복잡한 계획과 디버깅의 품질이 향상될 수 있지만, 더 많은 토큰을 사용할 수 있습니다."

msgid "Supported levels depend on your deployment. Provider default does not disable reasoning. For GPT reasoning with tools, prefer Responses; use None on Chat only if the deployment supports it."
msgstr "지원 수준은 배포에 따라 다릅니다. 제공업체 기본값은 추론을 비활성화하지 않습니다. GPT 추론과 도구를 함께 사용하려면 Responses를 권장합니다. Chat에서 '없음'은 배포가 지원하는 경우에만 사용하세요."

msgid "Use the resource's /openai/v1 base URL and exact deployment name. Responses supports reasoning with Orca function tools; requests use store=false. Select DeepSeek reasoning continuation for DeepSeek deployments."
msgstr "리소스의 /openai/v1 기본 URL과 정확한 배포 이름을 사용하세요. Responses는 Orca 함수 도구와 추론을 함께 지원하며, 요청에 store=false를 사용합니다. DeepSeek 배포에서는 DeepSeek 추론 이어가기를 선택하세요."

msgid "For GPT reasoning with tools, prefer Responses. Chat without reasoning requires a deployment that supports None. Select DeepSeek reasoning continuation for DeepSeek deployments."
msgstr "GPT 추론과 도구를 함께 사용하려면 Responses를 권장합니다. 추론 없는 Chat에는 '없음'을 지원하는 배포가 필요합니다. DeepSeek 배포에서는 DeepSeek 추론 이어가기를 선택하세요."

msgid "Request Timeouts"
msgstr "요청 시간 제한"

msgid "Use custom timeouts"
msgstr "시간 제한 직접 설정"

msgid "Override Orca's built-in response waits for this provider. Turning this off preserves your custom values."
msgstr "이 제공업체의 기본 응답 대기 시간을 변경합니다. 비활성화해도 설정한 값은 유지됩니다."

msgid "Using Orca's default timeouts.\nHeaders: 30 s · Inactivity: 60 s"
msgstr "Orca 기본 시간 제한 사용 중.\n헤더: 30초 · 무응답: 60초"

msgid "Original timing: 30 seconds to connect, 30 seconds for response headers, 60 seconds without body data, and 45 seconds for an Agent compatibility check. Each full request is capped at 10 minutes."
msgstr "기본 시간: 연결 30초, 응답 헤더 30초, 본문 데이터가 없는 시간 60초, 에이전트 호환성 검사 45초입니다. 전체 요청의 최대 시간은 10분입니다."

msgid "Response start"
msgstr "응답 시작"

msgid "Stream inactivity"
msgstr "스트림 무응답"

msgid "Maximum wait for headers and initial response data, including model loading. Accepts 10–600 seconds."
msgstr "모델 로딩을 포함한 헤더와 첫 응답 데이터의 최대 대기 시간입니다. 10~600초로 설정할 수 있습니다."

msgid "Maximum pause after response data begins. Reasoning and keep-alive bytes count as activity. Accepts 10–600 seconds."
msgstr "응답 데이터 수신이 시작된 후 허용하는 최대 무응답 시간입니다. 추론 및 연결 유지 데이터도 활동으로 계산됩니다. 10~600초로 설정할 수 있습니다."

msgid "Allow extra time for model loading and slow generation."
msgstr "모델 로딩과 느린 생성에 더 긴 대기 시간을 허용합니다."

msgid "Control how long Orca waits for this provider."
msgstr "이 제공업체의 대기 시간을 설정합니다."

msgid "Saved per provider · 10–600 s\n10-minute limit · Stop available"
msgstr "제공업체별 저장 · 10~600초\n최대 10분 · 중지 가능"

msgid "10-minute request limit.\nStop remains available."
msgstr "요청 시간은 최대 10분입니다.\n언제든 중지할 수 있습니다."

msgid "Agent Compatibility"
msgstr "에이전트 호환성"

msgid "Test & Enable Agent tools"
msgstr "도구 검사 및 활성화"

msgid "Run the project-free compatibility check and enable Agent tools for this exact profile only if it passes."
msgstr "프로젝트 데이터 없이 호환성을 검사하고, 통과한 경우에만 이 프로필의 에이전트 도구를 활성화합니다."

msgid "Enable Agent tools"
msgstr "에이전트 도구 활성화"

msgid "Enable Agent tools for this exact endpoint and model"
msgstr "이 엔드포인트와 모델의 도구 활성화"

msgid "This project-free check enables Agent tools when it passes. Agent tools may send project context and perform normal Plan/Work operations; edit permissions are controlled separately in the dock."
msgstr "프로젝트 데이터 없이 수행하는 이 검사를 통과하면 에이전트 도구가 활성화됩니다. 도구는 프로젝트 컨텍스트를 전송하고 일반적인 계획/작업 모드의 작업을 수행할 수 있습니다. 편집 권한은 도크에서 별도로 관리합니다."

msgid "Agent tools enabled for this exact profile."
msgstr "이 프로필의 에이전트 도구가 활성화되었습니다."

msgid "Compatibility passed. Agent tools are off."
msgstr "호환성 검사를 통과했습니다. 도구는 비활성화 상태입니다."

msgid "Run the compatibility probe."
msgstr "호환성 검사를 실행하세요."

msgid "Run Test & Enable Agent tools for this profile."
msgstr "이 프로필의 도구 검사 및 활성화를 실행하세요."

msgid "Profile changed. Run Test & Enable Agent tools again."
msgstr "프로필이 변경되었습니다. 도구 검사 및 활성화를 다시 실행하세요."

msgid "Profile changed during the check. Run Test & Enable Agent tools again."
msgstr "검사 중 프로필이 변경되었습니다. 도구 검사 및 활성화를 다시 실행하세요."

msgid "Compatibility passed, but Agent tools could not be enabled. Run the check again."
msgstr "호환성 검사를 통과했지만 도구를 활성화하지 못했습니다. 다시 검사하세요."

msgid "Compatibility check failed: %s"
msgstr "호환성 검사 실패: %s"

msgid "Testing Agent compatibility, step %d of 2..."
msgstr "에이전트 호환성 검사 중, %d / 2단계…"

msgid "Script edits"
msgstr "스크립트 편집"

msgid "Review edits"
msgstr "변경 검토"

msgid "Review edits (default)"
msgstr "변경 검토(기본값)"

msgid "Auto apply"
msgstr "자동 적용"

msgid "Auto apply for this project"
msgstr "이 프로젝트에 자동 적용"

msgid "Default script edits for this project"
msgstr "이 프로젝트의 기본 스크립트 편집"

msgid "Default script-edit behavior for this project on this computer. Auto apply requires explicit confirmation."
msgstr "이 컴퓨터에서 이 프로젝트에 사용할 기본 스크립트 편집 방식입니다. 자동 적용에는 명시적인 확인이 필요합니다."

msgid "Remember Auto apply for new Work conversations and editor restarts in this project. Plan stays read-only. Scene/configuration changes still require review. Clicking the green edit icon beside ORCA turns it off and clears the remembered choice."
msgstr "이 프로젝트의 새로운 작업 모드 대화와 에디터 재시작 후에도 자동 적용을 사용합니다. 계획 모드는 읽기 전용입니다. 씬/설정 변경은 여전히 검토가 필요합니다. ORCA 옆의 녹색 편집 아이콘을 클릭하면 자동 적용이 꺼지고 저장한 선택도 해제됩니다."

msgid "Allow automatic script edits"
msgstr "스크립트 자동 편집 허용"

msgid "Orca can create and edit eligible project .gd scripts automatically in Work mode. Every edit is validated, shown in the feed, and checkpointed before writing.\n\nScene/configuration changes and script-execution trust still require approval. Unsaved files and conflicts remain protected.\n\nWithout remembering, permission is for this session only. Remembering enables Auto apply for new Work conversations and editor restarts in this project. Plan stays read-only.\n\nClick the green edit icon beside ORCA in the header to revoke permission and clear any remembered default."
msgstr "Orca가 작업 모드에서 대상 프로젝트 .gd 스크립트를 자동으로 만들고 편집할 수 있습니다. 모든 변경은 검증되어 대화에 표시되며, 쓰기 전에 체크포인트가 저장됩니다.\n\n씬/설정 변경과 스크립트 실행 신뢰 확인에는 여전히 승인이 필요합니다. 저장하지 않은 파일과 충돌도 보호됩니다.\n\n선택을 저장하지 않으면 권한은 이 세션에만 적용됩니다. 저장하면 이 프로젝트의 새로운 작업 모드 대화와 에디터 재시작 후에도 자동 적용을 사용합니다. 계획 모드는 읽기 전용입니다.\n\n헤더의 ORCA 옆 녹색 편집 아이콘을 클릭하면 권한과 저장된 기본값을 해제할 수 있습니다."

msgid "Remember for this project"
msgstr "이 프로젝트에 선택 저장"

msgid "Use Auto apply by default for this project"
msgstr "이 프로젝트에서 자동 적용을 기본값으로 사용"

msgid "Use Auto apply by default for this project. This is saved locally, outside project files and conversation history."
msgstr "이 프로젝트에서 자동 적용을 기본값으로 사용합니다. 프로젝트 파일과 대화 기록 외부에 로컬로 저장됩니다."

msgid "Allow edits"
msgstr "편집 허용"

msgid "Script edit permission"
msgstr "스크립트 편집 권한"

msgid "Script edit permission: %s"
msgstr "스크립트 편집 권한: %s"

msgid "Remembered for this project: new Work conversations and editor restarts use Auto apply."
msgstr "이 프로젝트에 선택 저장됨: 새로운 작업 모드 대화와 에디터 재시작 후에도 자동 적용을 사용합니다."

msgid "Auto apply is enabled for this session only."
msgstr "자동 적용은 이 세션에서만 활성화됩니다."

msgid " Click to revoke before the next write and clear the remembered default. Stop keeps completed edits; Revert is a separate action."
msgstr " 클릭하면 다음 쓰기 전에 권한과 저장된 기본값이 해제됩니다. 중지해도 완료된 변경은 유지되며, 되돌리기는 별도 작업입니다."

msgid "Review edits is active. Click in idle Work or while reviewing a project script to allow session Auto apply, optionally remembered for this project. Scene/configuration proposals still require approval."
msgstr "변경 검토가 활성화되어 있습니다. 작업 모드 대기 중 또는 프로젝트 스크립트 검토 중에 클릭하면 세션의 자동 적용을 허용할 수 있으며, 이 프로젝트에 선택을 저장할 수도 있습니다. 씬/설정 제안에는 여전히 승인이 필요합니다."

msgid " The project default remains saved; Auto apply is paused here or unavailable in this mode/session."
msgstr " 프로젝트 기본값은 저장되어 있습니다. 자동 적용이 일시 중지되었거나 이 모드/세션에서는 사용할 수 없습니다."

msgid "The project preference could not be saved. No automatic edit permission was granted."
msgstr "프로젝트 설정을 저장하지 못했습니다. 자동 편집 권한은 부여되지 않았습니다."

msgid "Auto apply is off for this session, but its project default could not be saved."
msgstr "이 세션의 자동 적용은 꺼졌지만, 프로젝트 기본값을 저장하지 못했습니다."

msgid "ORCA ACCOUNT"
msgstr "ORCA 계정"

msgid "Sign in to access models provided by Orca."
