msgid "\n\nLocal request estimate: %d tokens (%s).\nSafe input budget: %d of %d tokens.\nReserved output: %d; future tool result: %d.\nIncludes request instructions, tool schemas/results, image reserves and private continuation when applicable. This estimate is separate from provider-reported usage and billing reservations."
msgstr "\n\n로컬 요청 추정: %d토큰(%s).\n안전한 입력 예산: %d / %d토큰.\n출력 예약: %d; 후속 도구 결과: %d.\n요청 지침, 도구 스키마/결과, 이미지 예약량 및 해당하는 경우 비공개 이어가기 정보를 포함합니다. 이 추정은 제공업체 보고 사용량 및 과금 예약량과 별개입니다."

msgid "Sign in to use Orca-hosted models."
msgstr "Orca 호스팅 모델을 사용하려면 로그인하세요."

msgid "Secure credential storage is unavailable. Enable your OS credential vault."
msgstr "안전한 자격 증명 저장소를 사용할 수 없습니다. OS 자격 증명 저장소를 활성화하세요."

msgid "Orca Cloud could not start sign-in. Check your connection and try again."
msgstr "Orca Cloud 로그인을 시작하지 못했습니다. 연결을 확인하고 다시 시도하세요."

msgid "Sign in or sign up in your browser, then approve this editor."
msgstr "브라우저에서 로그인하거나 가입한 후 이 에디터를 승인하세요."

msgid "The account service returned invalid credentials. Start sign-in again."
msgstr "계정 서비스가 잘못된 자격 증명을 반환했습니다. 로그인을 다시 시작하세요."

msgid "The OS credential vault could not be opened. Unlock it and sign in again."
msgstr "OS 자격 증명 저장소를 열지 못했습니다. 잠금을 해제하고 다시 로그인하세요."

msgid "Your connection could not be saved securely. Unlock the OS vault and try again."
msgstr "연결 정보를 안전하게 저장하지 못했습니다. OS 저장소의 잠금을 해제하고 다시 시도하세요."

msgid "Sign-in was declined or interrupted. Start a new connection."
msgstr "로그인이 거부되거나 중단되었습니다. 새 연결을 시작하세요."

msgid "The pairing code expired. Sign in again to get a new code."
msgstr "연결 코드가 만료되었습니다. 다시 로그인하여 새 코드를 받으세요."

msgid "Sign-in cancelled."
msgstr "로그인이 취소되었습니다."

msgid "Refresh your account connection before the next request."
msgstr "다음 요청 전에 계정 연결을 새로고침하세요."

msgid "Account information could not be refreshed. Reconnect if your session was revoked."
msgstr "계정 정보를 새로고침하지 못했습니다. 세션이 해제된 경우 다시 연결하세요."

msgid "The account service returned invalid account information."
msgstr "계정 서비스가 잘못된 계정 정보를 반환했습니다."

msgid "Your account is connected. Hosted models are ready to use."
msgstr "계정이 연결되었습니다. 호스팅 모델을 사용할 수 있습니다."

msgid "Signing out…"
msgstr "로그아웃 중…"

msgid "Signed out locally. Check Orca Console to revoke the editor session if the backend or OS vault was unavailable."
msgstr "로컬에서 로그아웃되었습니다. 백엔드 또는 OS 저장소를 사용할 수 없었다면 Orca Console에서 에디터 세션을 해제하세요."

msgid "The backend is offline. Your saved connection is retained; use Refresh account when it is available."
msgstr "백엔드가 오프라인입니다. 저장된 연결 정보는 유지됩니다. 사용 가능해지면 계정 새로고침을 실행하세요."

msgid "Your saved connection could not be restored. Check the backend and OS vault, then sign in again if needed."
msgstr "저장된 연결을 복원하지 못했습니다. 백엔드와 OS 저장소를 확인하고 필요하면 다시 로그인하세요."

msgid "Updates come from official Orca GitHub Releases."
msgstr "업데이트는 공식 Orca GitHub Releases에서 가져옵니다."

msgid "Orca %s is available."
msgstr "Orca %s을(를) 사용할 수 있습니다."

msgid "Downloading Orca %s…"
msgstr "Orca %s 다운로드 중…"

msgid "Update installed. Your previous addon is retained for rollback."
msgstr "업데이트가 설치되었습니다. 이전 애드온은 복원을 위해 유지됩니다."

msgid "The previous addon was restored."
msgstr "이전 애드온이 복원되었습니다."

msgid "The previous update stopped."
msgstr "이전 업데이트가 중지되었습니다."

msgid "Checking GitHub Releases…"
msgstr "GitHub Releases 확인 중…"

msgid "Could not check for updates."
msgstr "업데이트를 확인하지 못했습니다."

msgid "Unsupported release metadata."
msgstr "지원하지 않는 릴리스 메타데이터입니다."

msgid "Checking installed addon files…"
msgstr "설치된 애드온 파일 확인 중…"

msgid "Verifying and staging the release…"
msgstr "릴리스 검증 및 준비 중…"

msgid "Verified. Preparing the editor restart…"
msgstr "검증되었습니다. 에디터 재시작 준비 중…"

msgid "Closing Godot; the verified updater will reopen this project."
msgstr "Godot를 종료합니다. 검증된 업데이트 도구가 이 프로젝트를 다시 엽니다."

msgid "GDScript is valid."
msgstr "GDScript가 유효합니다."

msgid "No GDScript validation required."
msgstr "GDScript 검증이 필요하지 않습니다."

msgid "Parsed and verified project.godot Input Map state."
msgstr "project.godot 입력 맵 상태를 분석하고 검증했습니다."

msgid "Loaded the saved target as a PackedScene and verified project.godot."
msgstr "저장된 대상을 PackedScene으로 불러오고 project.godot를 검증했습니다."

msgid "Validated allowlisted typed settings and parsed the candidate project.godot."
msgstr "허용된 타입 지정 설정을 검증하고 후보 project.godot를 분석했습니다."

msgid "Packed, saved, and reloaded the complete proposed scene as a PackedScene."
msgstr "제안된 전체 씬을 PackedScene으로 패킹하고, 저장하고, 다시 불러왔습니다."

msgid "Trusted script loaded; packed, saved, and reloaded the complete proposed scene."
msgstr "신뢰된 스크립트를 불러왔으며, 제안된 전체 씬을 패킹하고, 저장하고, 다시 불러왔습니다."

msgid "Hash-bound intent validated without loading the scene or compiling the script. Approval may execute script initialization while constructing and revalidating the candidate."
msgstr "씬을 불러오거나 스크립트를 컴파일하지 않고 해시에 연결된 의도를 검증했습니다. 승인하면 후보를 구성하고 재검증하는 동안 스크립트 초기화가 실행될 수 있습니다."

msgid "Viewport width"
msgstr "뷰포트 너비"

msgid "Viewport height"
msgstr "뷰포트 높이"

msgid "Window width override"
msgstr "창 너비 재정의"

msgid "Window height override"
msgstr "창 높이 재정의"

msgid "Stretch mode"
msgstr "늘이기 모드"

msgid "Stretch aspect"
msgstr "늘이기 화면 비율"

msgid "API Key (optional)"
msgstr "API 키(선택 사항)"

msgid "OpenAI API Key"
msgstr "OpenAI API 키"

msgid "Gemini API Key"
msgstr "Gemini API 키"

msgid "OpenRouter API Key"
msgstr "OpenRouter API 키"

msgid "DeepSeek API Key"
msgstr "DeepSeek API 키"

msgid "Azure API Key"
msgstr "Azure API 키"

msgid "xAI API Key"
msgstr "xAI API 키"

msgid "OpenAI-compatible"
msgstr "OpenAI 호환"

msgid "Local OpenAI-compatible"
msgstr "로컬 OpenAI 호환"

msgid "\n\nKeeps the scene open and preserves normal Godot Undo. Applies the reviewed native property in the editor only; save the scene before running it."
msgstr "\n\n씬을 열어 둔 채 Godot의 일반 실행 취소를 유지합니다. 검토한 네이티브 속성은 에디터에서만 적용됩니다. 실행 전에 씬을 저장하세요."

msgid "\nDerived   %s: %s → %s"
msgstr "\n파생 값   %s: %s → %s"

msgid "\nRequested %s\nThe proposed value uses Godot's native numeric precision."
msgstr "\n요청 값   %s\n제안 값에는 Godot의 네이티브 숫자 정밀도가 사용됩니다."

msgid "\nSource    %s (%s)"
msgstr "\n출처      %s (%s)"

msgid "Validated the saved native transform and instance provenance without loading scenes or scripts."
msgstr "씬이나 스크립트를 로드하지 않고 저장된 네이티브 변환과 인스턴스 출처를 검증했습니다."
