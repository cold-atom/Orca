msgstr "No preguntar más"

msgid "Open Orca's GitHub repository in your browser"
msgstr "Abrir el repositorio de Orca en GitHub en tu navegador"

msgid "Open Orca's Godot Asset Library page in your browser"
msgstr "Abrir la página de Orca en Godot Asset Library en tu navegador"

